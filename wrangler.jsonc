// Cloudflare Worker that serves the built site. Workers Builds installs dependencies and runs
// `npx wrangler deploy`, which runs the build below first and uploads dist/ as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imkhubaibraza-github-io",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
